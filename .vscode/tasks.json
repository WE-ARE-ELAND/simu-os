{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make: all",
            "type": "shell",
            "command": "make",
            "args": ["-f", "makefile"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "make: run",
            "type": "shell",
            "command": "make",
            "args": ["-f", "makefile", "run"]
        },
        {
            "label": "make: clean",
            "type": "shell",
            "command": "make",
            "args": ["-f", "makefile", "clean"]
        },
        {
            "label": "test: all",
            "type": "shell",
            "command": "make",
            "args": ["-C", "tests", "-f", "makefile.disk", "run"],
            "group": { "kind": "test", "isDefault": true }
        }
    ]
}
