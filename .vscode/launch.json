{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SimuOS",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/launch.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "preLaunchTask": "make: all",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
